# react-drm hardware profile — KaiT2en (T2 Fedora fork).
#
# Source this file (or export these variables) before building/running so the
# app, control center and installers all use a single, coherent set of hardware
# names for this distro. Values are comma-separated arrays; each is optional and
# falls back to the t2linux defaults if unset.
#
#   source env.example.kait2en

# Touch Bar backlight sysfs nodes, in preference order.
REACT_DRM_TB_BACKLIGHT_NAMES=t2tb_backlight,display-pipe

# Host display (laptop panel) backlight candidates, in preference order.
REACT_DRM_DISP_BACKLIGHT_NAMES=apple-panel-bl

# Touch Bar DRM panel driver name.
REACT_DRM_DRM_DRIVER=t2bdrm

# Touch Bar Display USB id (Apple, T2 Touch Bar).
REACT_DRM_USB_VENDOR=05ac
REACT_DRM_USB_PRODUCT=8302

# Built-in T2 keyboard bridge tokens (substring match over the syspath).
REACT_DRM_USB_BRIDGE=t2bce

# Optional boot logo shown while react-drm starts. Absolute path to a PNG.
# Unset for no logo; the control center falls back to the plain spinner when
# this file is missing, so t2linux keeps the original look.
REACT_DRM_BOOT_LOGO=public/kait2en-wordmark.png

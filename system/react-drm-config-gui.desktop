# Launches config-gui. electron isn't a standalone binary — it's the npm
# workspace's hoisted node_modules/.bin/electron run against the config-gui
# app directory, same as `npm start` would. The Exec= line below assumes the
# conventional install path (~/react-drm); install.sh's
# install_config_gui_launcher() rewrites it to the actual repo path at
# install time (same reason install_user_service() does this for
# react-drm.service — the repo isn't always cloned to that exact path), so
# don't rely on this file's own Exec= if you installed some other way.
# Manual install (only correct if the repo really is at ~/react-drm):
#   install -Dm644 system/react-drm-config-gui.desktop \
#     ~/.local/share/applications/react-drm-config-gui.desktop
[Desktop Entry]
Type=Application
Name=Touch Bar Config
Comment=Edit the touch bar's config.ts
Exec=%h/react-drm/node_modules/.bin/electron %h/react-drm/config-gui
Icon=preferences-system
Terminal=false
Categories=Settings;

# Launches config-gui-python. Runs the Python GTK editor.
# The Exec= line below assumes the conventional install path (~/react-drm);
# install.sh's install_config_gui_launcher() rewrites it to the actual repo
# path at install time.
[Desktop Entry]
Type=Application
Name=Touch Bar Config
Comment=Edit the touch bar's config.ts
Exec=python3 %h/react-drm/config-gui-python/config_gui.py
Icon=preferences-system
Terminal=false
Categories=Settings;

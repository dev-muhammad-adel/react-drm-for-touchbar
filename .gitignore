# Generated at install time by the distro installers — each copies its own
# 99-react-drm-<distro>.rules into this canonical name.
system/99-react-drm.rules

# Custom Layer prototype's own storage — written by config-gui, watched by
# the Touch Bar app. Separate from config.ts; never tracked.
linux-touchbar-control-center/custom-layer.json

